{
  "$comment": "Atlas Core default chart theme (Atlas Neutral). An app overrides it with its own theme/web/com.mendix.charts.json. Charts only read it when 'Enable theme folder config loading' is on.",
  "layout": {
    "colorway": ["#3b64a8", "#d9773a", "#2a9d8f", "#7b5ea7", "#c4577a", "#6b8e3a", "#8a5a00", "#4a9fd4", "#243b53", "#8a94a2"],
    "piecolorway": ["#3b64a8", "#d9773a", "#2a9d8f", "#7b5ea7", "#c4577a", "#6b8e3a", "#8a5a00", "#4a9fd4", "#243b53", "#8a94a2"],
    "font": {
      "family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "size": 12,
      "color": "#5b6573"
    },
    "paper_bgcolor": "rgba(0,0,0,0)",
    "plot_bgcolor": "rgba(0,0,0,0)",
    "xaxis": { "gridcolor": "#edf0f3", "linecolor": "#c5ccd5", "zerolinecolor": "#c5ccd5" },
    "yaxis": { "gridcolor": "#edf0f3", "linecolor": "#c5ccd5", "zerolinecolor": "#c5ccd5" },
    "legend": { "font": { "color": "#5b6573" } },
    "hoverlabel": { "bordercolor": "#e1e5ea" }
  },
  "configuration": {
    "displayModeBar": false
  }
}
